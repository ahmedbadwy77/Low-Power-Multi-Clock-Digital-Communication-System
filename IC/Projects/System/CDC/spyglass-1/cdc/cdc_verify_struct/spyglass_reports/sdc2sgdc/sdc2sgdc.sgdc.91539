current_design  "SYSTEM_TOP"

########################################################################
#Section 1: List of source clocks
#These clocks have set_false_path/set_clock_groups/set_clock_uncertainty associated with them
#./SYSTEM_TOP.sdc@@14@@
clock  -name "REF_CLK"  -domain d0  -edge { "0.000000" "5.000000"}  -period 10 -tag ref_clk 
#./SYSTEM_TOP.sdc@@21@@
clock  -name "UART_CLK"  -domain d1  -edge { "0.000000" "135.634003"}  -period 271.266998 -tag uart_clk 

